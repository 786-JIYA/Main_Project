<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/styleCreate.css">
    <script src="https://kit.fontawesome.com/295da72d04.js" crossorigin="anonymous"></script>
</head>

<body>

    <div class="main">

        <!-- SIDEBAR -->
        <aside id="sidebar">
            <h2 class="logo">🚌 Smart Bus</h2>

            <ul>
                <li><a href="/read"><i class="fa-solid fa-users"></i> Students</a></li>
                <li><a href="/list"><i class="fa-solid fa-bus"></i> Bus List</a></li>
                <li><a href="/attendance"><i class="fa-solid fa-clipboard-check"></i> Attendance</a></li>
            </ul>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="content">

            <div class="center-box"> <!-- NEW WRAPPER -->

                <header class="page-header">
                    <h1>Add New Student</h1>
                </header>

                <div class="form-card">
                    <form action="/create" method="post">

                        <label>Student Name</label>
                        <input type="text" name="name" placeholder="Enter student name" required>

                        <label>PRN</label>
                        <input type="text" name="PRN" placeholder="Enter PRN" required>

                        <label>Place</label>
                        <input type="text" name="place" placeholder="Enter place" required>

                        <button type="submit">➕ Add Student</button>

                    </form>
                </div>

            </div>

        </div>

    </div>

</body>

</html>