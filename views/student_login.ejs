<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link rel="shortcut icon" type="image/png" href="/icon.png" />

    <link href="https://fonts.googleapis.com/css?family=Poppins:400,500,600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/stylesheets/student_login.css" />
    <title>Bankist</title>
</head>

<body>
    <!-- TOP NAVIGATION -->
    <nav>
        <p class="welcome">Log in to get started</p>
        <h2 class="h2">Enter Place and PRN &rarr;</h2>

        <!-- ✅ NEW INSTRUCTION -->

        <form class="login">
            <input type="text" " class=" login__input login__input--user" />
            <input type="text" " maxlength=" 4" class="login__input login__input--pin" />
            <button class="login__btn">&rarr;</button>
        </form>
    </nav>

    <main class="app">
        <!-- BALANCE -->
        <div class="balance">
            <div>
                <p class="balance__label">Bus List</p>
                <p class="balance__date">
                    As of <span class="date">11/04/2026</span>
                </p>
                <p class="demo-note">
                    👉 For demo use: <strong>Sangli</strong> as Place and your <strong>College PRN</strong>
                </p>
            </div>
            <p class="balance__value"></p>
        </div>

        <!-- MOVEMENTS -->
        <div class="movements">
            <div class="movements__row">
                <!--div class="movements__type movements__type--deposit">2 deposit</div>-->
                <div class="movements__date"></div>
                <div class="movements__value"></div>

            </div>
            <div class="movements__row">
                <!--<div class="movements__type movements__type--withdrawal">
                    1 withdrawal
                </div>-->
                <div class="movements__date"></div>
                <div class="movements__value"></div>
            </div>
        </div>


        <!-- OPERATION: TRANSFERS -->
        <div class="operation operation--transfer">
            <h2>Travel</h2>
            <form class="form form--transfer">
                <input type="text" class="form__input form__input--from" />
                <input type="text" class="form__input form__input--where" />
                <button class="form__btn form__btn--transfer">&rarr;</button>
                <label class="form__label" placeholder="Place (e.g. Sangli)">From to</label>
                <label class=" form__label" placeholder="(e.g. college)">Where</label>
            </form>
        </div>

        <!-- OPERATION: LOAN -->
        <div class=" operation operation--loan">
            <h2>Track Bus</h2>
            <form class="form form--loan">
                <input type="number" class="form__input form__input--loan-amount" />
                <button class="form__btn form__btn--loan"><a href="https://tracking-r5ir.onrender.com/location"
                        class="Go"> Go
                    </a></button>
                <label class="form__label form__label--loan">Enter Bus No. to track</label>
            </form>
        </div>

    </main>



    <script src="/javascript/student_login.js"></script>
</body>

</html>