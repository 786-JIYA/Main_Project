<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://kit.fontawesome.com/295da72d04.js" crossorigin="anonymous"></script>
</head>

<body>

    <!-- TOP BAR -->
    <div class="actions">
        <a href="/index" class="btn add-btn">
            <i class="fa-solid fa-user-plus"></i> Add Student
        </a>

        <a href="https://bus-dashboard.onrender.com/attendance" class="btn attendance-btn">
            <i class="fa-solid fa-clipboard-check"></i> Attendance
        </a>
    </div>

    <!-- PAGE TITLE + SEARCH -->
    <section class="controls">
        <h1>Students</h1>

        <div class="search_container">
            <input type="search" placeholder="Search students..." class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
    </section>

    <!-- TABLE CARD -->
    <section class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>PRN</th>
                    <th>Place</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% users.forEach(function(user){ %>
                    <tr>
                        <td>
                            <%= user.name %>
                        </td>
                        <td>
                            <%= user.PRN %>
                        </td>
                        <td>
                            <%= user.place %>
                        </td>
                        <td>
                            <a href="/delete/<%=user._id%>" class="delete-btn">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </section>

</body>

</html>